{
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Block major bumps of the lint/type toolchain. eslint 10 is unsupported by eslint-plugin-react (caps at eslint ^9.7, still uses removed context.getFilename), and typescript 7 breaks @typescript-eslint (<6.1) and ts-node. Re-enable once the plugin ecosystem catches up.",
      "matchPackageNames": ["eslint", "typescript"],
      "matchPackagePatterns": ["^eslint-", "^@typescript-eslint/"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "enabled": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "packagePatterns": ["^eslint"],
      "groupName": "eslint"
    },
    {
      "packagePatterns": ["gatsby"],
      "groupName": "gatsby"
    },
    {
      "packageNames": ["react", "react-dom", "react-test-renderer"],
      "groupName": "react"
    },
    {
      "groupName": "node",
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ],
  "labels": ["renovate"],
  "rangeStrategy": "bump",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 20,
  "semanticCommits": "enabled",
  "platformAutomerge": true
}
