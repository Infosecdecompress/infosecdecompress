{
  "name": "infosecdecompress",
  "version": "5.0.0",
  "description": "資安解壓縮的家 Website of Infosec Decompress",
  "keywords": [
    "gatsby",
    "podcast",
    "security",
    "infosec",
    "zh-tw"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Infosecdecompress/infosecdecompress"
  },
  "license": "MIT",
  "author": "Jeffrey Hung <jeff@infosecdecompress.com>",
  "scripts": {
    "build": "npm run clean && gatsby build",
    "clean": "rimraf .cache public",
    "deploy": "npm run build && gh-pages -d public -b gh-pages",
    "develop": "gatsby develop",
    "format": "npm run format:ts && npm run format:scss",
    "format:scss": "stylelint \"src/**/*.scss\" --fix",
    "format:ts": "eslint . --fix && prettier --write .",
    "lint": "npm run lint:ts && npm run lint:scss && npm run typecheck",
    "lint:commit": "commitlint",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:ts": "eslint . && prettier --check .",
    "prepare": "husky",
    "serve": "gatsby serve",
    "start": "npm run develop",
    "test": "jest --config ./internal/testing/jest-config.mts",
    "test:update-snapshot": "npm run test -- --updateSnapshot",
    "test:watch": "npm run test -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,sass,css}": [
      "stylelint --fix"
    ],
    "*.{js,json,md,mdx,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@ardatan/relay-compiler": {
      "immutable": "~3.8.4"
    },
    "external-editor": {
      "tmp": "^0.2.7"
    },
    "gatsby": {
      "cookie": "^0.7.2",
      "path-to-regexp": "0.1.13",
      "uuid": "^11.1.1"
    },
    "gatsby-plugin-sass": {
      "resolve-url-loader": "^5.0.0",
      "sass-loader": "^17.0.1"
    },
    "lodash": "^4.18.1",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.4",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@alxshelepenok/diesel": "^1.0.1367",
    "@alxshelepenok/diesel-extensions": "^1.0.1243",
    "@sentry/gatsby": "^11.6.0",
    "@sentry/react": "^11.6.0",
    "classnames": "^2.5.1",
    "disqus-react": "^1.1.7",
    "gatsby": "^5.16.1",
    "gatsby-plugin-catch-links": "^5.16.0",
    "gatsby-plugin-csp": "^1.1.4",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-security-txt": "^1.2.1",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-responsive-iframe": "^6.16.0",
    "gatsby-remark-smartypants": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "js-search": "^2.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/gatsby-transformer-remark": "^2.9.4",
    "@types/jest": "^30.0.0",
    "@types/js-search": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gh-pages": "^6.3.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "6.1.3",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-order": "^8.1.2",
    "stylelint-scss": "^7.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
